# Copy to .env. These are public values (safe to ship in the extension); RLS protects the data.
WXT_SUPABASE_URL=https://your-project-ref.supabase.co
WXT_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Set to true after enabling the Google provider in Supabase (see the options page for the redirect URL).
WXT_GOOGLE_SIGN_IN=false
