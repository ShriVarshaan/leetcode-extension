# Copy this file to .env and fill in your values. Never commit .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection, used only to run migrations (Supabase: Connect -> Session pooler)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
# Weekly summary email (pnpm deploy-weekly). Gmail: use an app password, not your account password.
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
